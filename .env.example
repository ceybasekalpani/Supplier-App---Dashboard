# Copy this file to .env and replace placeholder values.
# VITE_ variables are public in the browser. Never place real secrets in VITE_ variables.

VITE_APP_NAME="Tea Factory Supplier Admin"
VITE_APP_ENV="development"
# In development, keep API base empty so Vite proxies /api to ASP.NET Core.
VITE_API_BASE_URL=""
VITE_API_PROXY_TARGET="http://localhost:5295"
VITE_ENABLE_MOCK_DATA="false"

# Server-only examples. Use these only in backend/server code.
APP_ENCRYPTION_KEY="change-me"
JWT_SIGNING_SECRET="change-me"
DATABASE_URL="postgresql://user:password@localhost:5432/supplier_app"
SMTP_PASSWORD="change-me"
